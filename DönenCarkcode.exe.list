[ 662]        :                                       ; --- DONEN CARKI VE YAZILARI CIZME (OYUNUN ANA ANIMASYONU) ---
[ 663]    06F5:                                       carki_ciz proc
[ 664]    06F5: 50                                    push ax
[ 665]    06F6: 53                                    push bx
[ 666]    06F7: 51                                    push cx
[ 667]    06F8: 52                                    push dx
[ 668]    06F9: 56                                    push si
[ 669]    06FA: 57                                    push di
[ 670]    06FB: 06                                    push es
[ 671]    06FC: FC                                    cld                 ; String okuma isleminde yonu soldan saga ayarla
[ 672]    06FD: B8 00 B8                              mov ax, 0B800h
[ 673]    0700: 8E C0                                 mov es, ax          ; VRAM bellek adresini ES'ye tanit
[ 674]        :                                       
[ 675]        :                                       ; 1) Ortadaki cizgi animasyonu
[ 676]    0702: 33 DB                                 xor bx, bx
[ 677]    0704: 8A 1E 07 00                           mov bl, spin_pos    ; Donme sekli indeksi (0, 1, 2, 3)
[ 678]    0708: 8A 87 8B 01                           mov al, spin_tab[bx]; Indekse gore sembolu al ('|', '/', '-', '\')
[ 679]    070C: B4 0F                                 mov ah, 0Fh         ; Parlak Beyaz renk kodu
[ 680]    070E: BF 30 07                              mov di, 1840        ; Merkezin (R11, C40) VRAM bellek adresi
[ 681]    0711: 26 89 05                              mov es:[di], ax     ; Sembolu direkt ekranin ortasina yapistir
[ 682]        :                                       
[ 683]        :                                       ; 2) Dilim Yazilarini Yerlestirme
[ 684]    0714: C6 06 06 00 00                        mov slot_tmp, 0     ; 8 ayri dilimi cizmek icin dongu sayaci (0'dan baslar)
[ 685]    0719:                                       draw_all_slots:
[ 686]    0719: A0 03 00                              mov al, cark_idx    ; Donen carkin o anki indexini AL'ye al
[ 687]    071C: 02 06 06 00                           add al, slot_tmp    ; O an cizilecek dilimin kacinci sirada oldugunu bul
[ 688]    0720: 3C 08                                 cmp al, 8           ; Eger 8'e ulastiysa (8 dilim var)
[ 689]    0722: 72 02                                 jb idx_ready
[ 690]    0724: 2C 08                                 sub al, 8           ; 8 cikararak basa (0, 1..) sar. (Matematikteki Mod alma)
[ 691]    0726:                                       idx_ready:
[ 692]    0726: 32 E4                                 xor ah, ah          ; AH'yi sifirla ki AX tam bir rakam olsun
[ 693]    0728: 8B D8                                 mov bx, ax          ; Indeksi BX'e gecir (Dizi okumak icin zorunlu)
[ 694]    072A: D1 E3                                 shl bx, 1           ; Adresler word (2 byte) yer kapladigindan dizini 2 ile carp
[ 695]    072C: 8B B7 C7 01                           mov si, str_ptr[bx] ; O yazinin ('[ 100 ]' gibi) hafizadaki baslangic adresini al
[ 696]        :                                       
[ 697]    0730: 8B D8                                 mov bx, ax          ; Renk tablosu byte byte (1 byte) oldugu icin carpmasiz al
[ 698]    0732: 8A A7 E7 01                           mov ah, col_val[bx] ; Bu yaziya ozel rengi AH (Renk Kodu) icine at
[ 699]        :                                       
[ 700]    0736: 33 DB                                 xor bx, bx
[ 701]    0738: 8A 1E 06 00                           mov bl, slot_tmp    ; Su an ekranin neresine cizdigimizi tutan sayac
[ 702]    073C: D1 E3                                 shl bx, 1           ; VRAM adres dizisi de word boyutunda, yine 2 ile carp
[ 703]    073E: 8B BF EF 01                           mov di, d_vram[bx]  ; Yazinin ekranda duracagi dogru VRAM adresini al
[ 704]        :                                       
[ 705]    0742: B9 07 00                              mov cx, 7           ; Cizilecek stringin uzunlugu 7 harftir (ornegin '[ 100 ]')
[ 706]    0745:                                       draw_str:
[ 707]    0745: AC                                    lodsb               ; SI'nin gosterdigi adresten 1 harf (byte) alip AL registerina koyar
[ 708]    0746: AB                                    stosw               ; AX registerini (AH'da renk, AL'de harf var) VRAM'e yazar (di artar)
[ 709]    0747: E2 FC                                 loop draw_str       ; 7 karakter yazilana kadar kelime kelime devam et
[ 710]        :                                       
[ 711]    0749: FE 06 06 00                           inc slot_tmp        ; Bir sonraki cark dilimini cizmek icin sayaci artir
[ 712]    074D: 80 3E 06 00 08                        cmp slot_tmp, 8     ; 8 dilim bitti mi?
[ 713]    0752: 72 C5                                 jb draw_all_slots   ; Bitmediyse draw_all_slots etiketine don
[ 714]        :                                       
