[ 648]    06E5: B0 6F                                 mov al, 'o'         ; Ekrana Basilacak harf 'o'
[ 649]    06E7: B3 08                                 mov bl, 08h         ; Koyu gri renk
[ 650]    06E9: E8 59 FF                              call renkli_kar     ; Noktayi ciz
[ 651]    06EC: 46                                    inc si              ; Bir sonraki koordinata gec
[ 652]    06ED: E2 EE                                 loop cb             ; Donguyu devam ettir
[ 653]        :                                       
[ 654]    06EF: 5E                                    pop si
[ 655]    06F0: 5A                                    pop dx
